% % Formattazione asse X (Mostriamo solo la parte reale per brevità)
% labels_sorted = cell(26, 1);
% for i = 1:26
%     labels_sorted{i} = sprintf('%.2f', real(autovalori_sorted(i)));
% end
% xticks(1:26);
