%% PLOT PRESENTATION SUITE - Solo Grafici Chiave
clc; close all;

% Lista File (Assicurati che i nomi coincidano con quelli nella cartella)
files = {'Results_Recovery_{Hover}.mat', ...
         'Results_Takeoff_{Ground}.mat', ...
         'Results_Cruise_{Flight}.mat'};

% files = {'Results_Cruise_{Flight}.mat'};

% Impostazioni Grafiche "Publication Quality"
set(0, 'DefaultAxesFontSize', 14);       % Font assi leggibile
set(0, 'DefaultLineLineWidth', 1.0);     % Linee marcate
set(0, 'DefaultAxesLineWidth', 1.2);     % Bordi assi marcati
set(0, 'DefaultLegendFontSize', 12);

%% CICLO DI GENERAZIONE
for k = 1:length(files)
    filename = files{k};
    
    if ~isfile(filename)
        fprintf('[SKIP] File %s non trovato.\n', filename);
        continue;
    end
    
    fprintf('>> Elaborazione %s ...\n', filename);
    data = load(filename);
    
    if isfield(data, 'risultati') && isfield(data, 'cfg')
        % SELETTORE SCENARIO INTELLIGENTE
        % Sceglie quale grafico fare in base al nome dello scenario
        if contains(data.cfg.name, 'Takeoff', 'IgnoreCase', true)
            Plot_Takeoff_Focus(data.risultati, data.cfg);
            
        elseif contains(data.cfg.name, 'Recovery', 'IgnoreCase', true)
            Plot_Recovery_Focus(data.risultati, data.cfg);
            
        elseif contains(data.cfg.name, 'Cruise', 'IgnoreCase', true)
            Plot_Cruise_Focus(data.risultati, data.cfg);
        end
    end
end
fprintf('>> Grafici pronti.\n');

%% ---------------------------------------------------------
%  FUNZIONE 1: DECOLLO (Solo Quota Z)
%  ---------------------------------------------------------
function Plot_Takeoff_Focus(risultati, cfg)
    figure(1); clf;
    set(gcf, 'Name', 'Decollo: Quota e Spinta', 'Position', [100 100 800 600]);
    
    N = length(risultati);
    target_z = -cfg.target(3);
    col_z = [0 0.6 0.3 0.15];  % Verde Smeraldo
    col_t = [0 0.4 0.8 0.15];  % Blu Cobalto
    
    k_val = 7*(10^-5);
    m_val = 6.7;
    g_val = 9.8;
    
    % Subplot 1: Quota
    subplot(2,1,1); hold on; grid on; grid minor;
    title('Scenario Decollo: Dinamica di involo', 'FontSize', 16);
    ylabel('Quota [m]', 'FontWeight', 'bold');
    
    % Subplot 2: Spinta Totale (Thrust)
    subplot(2,1,2); hold on; grid on; grid minor;
    ylabel('Spinta Totale [N]', 'FontWeight', 'bold');
    xlabel('Tempo [s]');

    for i = 1:N
        if risultati(i).converged
            t = risultati(i).t;
            z = -risultati(i).x(:,3);
            
            % Calcolo spinta usando il valore k_val estratto
            thrust_tot = k_val * (risultati(i).x(:,21).^2 + ...
                                  risultati(i).x(:,23).^2 + ...
                                  risultati(i).x(:,25).^2);
            
            subplot(2,1,1); plot(t, z, 'Color', col_z, 'LineWidth', 1.2);
            subplot(2,1,2); plot(t, thrust_tot, 'Color', col_t, 'LineWidth', 1.2);
        end
    end
    
    subplot(2,1,1); yline(target_z, '--k', 'Target', 'LineWidth', 2);
    subplot(2,1,1); ylim([0 target_z + 5]);

    % Linea del peso (mg) per riferimento
    weight = m_val * g_val;
    subplot(2,1,2); h_w = yline(weight, '--r', 'Peso (mg)', 'LineWidth', 2);
    subplot(2,1,2); ylim([0 weight + 40]); % Margine per vedere lo spunto iniziale
end

%% ---------------------------------------------------------
%  FUNZIONE 2: RECOVERY (Spaghetti Plot Posizione)
%  ---------------------------------------------------------
function Plot_Recovery_Focus(risultati, cfg)
    figure(2); clf;
    set(gcf, 'Name', 'Recovery: Assetto e Attuatori', 'Position', [100 100 1000 700]);

    k_val = 7*(10^-5);
    m_val = 6.7;
    
    N = length(risultati);
    % Palette: Blu (Velocità), Rosso (Pitch), Arancio (Tilt Rotori)
    col_v = [0 0.45 0.74 0.1];
    col_th = [0.85 0.33 0.1 0.1];
    col_tilt = [0.93 0.69 0.13 0.1];

    % Subplot 1: Velocità Vx (Le sinusoidi)
    subplot(3,1,1); hold on; grid on;
    ylabel('V_x [m/s]', 'FontWeight', 'bold');
    title('Recovery: Accoppiamento Velocità-Assetto-Rotori', 'FontSize', 16);
    
    % Subplot 2: Assetto Pitch (Theta)
    subplot(3,1,2); hold on; grid on;
    ylabel('Pitch \theta [deg]', 'FontWeight', 'bold');
    
    % Subplot 3: Tilt Rotori Anteriori (Apertura Servi)
    subplot(3,1,3); hold on; grid on;
    ylabel('Tilt Servi [deg]', 'FontWeight', 'bold');
    xlabel('Tempo [s]');

    for i = 1:N
        if risultati(i).converged && ~risultati(i).crashed
            t = risultati(i).t;
            % Estrazione dati
            vx = risultati(i).x(:,4);
            theta = rad2deg(risultati(i).x(:,8));
            tilt_1 = rad2deg(risultati(i).x(:,13)); % Angolo reale servocomando 1

            subplot(3,1,1); plot(t, vx, 'Color', col_v);
            subplot(3,1,2); plot(t, theta, 'Color', col_th);
            subplot(3,1,3); plot(t, tilt_1, 'Color', col_tilt);
        end
    end
    
    % Aggiunta target e limiti
    subplot(3,1,1); yline(0, '--k', 'Hover', 'LineWidth', 2);
    subplot(3,1,2); yline(0, '--k', 'LineWidth', 1.5);
    subplot(3,1,3); yline(90, '--r', 'Verticale', 'LineWidth', 1.5);
end

%% ---------------------------------------------------------
%  FUNZIONE 3: CROCIERA (Vx "Tubo" + Quota)
%  ---------------------------------------------------------
function Plot_Cruise_Focus(risultati, cfg)
    figure(3); clf;
    set(gcf, 'Name', 'Cruise: Precisione e Assetto', 'Position', [200 200 900 600]);

    k_val = 7*(10^-5);
    m_val = 6.7;
    
    N = length(risultati);
    col_vx = [0.6350 0.0780 0.1840 0.15]; % Rosso
    col_th = [0 0.4470 0.7410 0.15];      % Blu
    
    subplot(2,1,1); hold on; grid on;
    ylabel('V_x [m/s]', 'FontWeight', 'bold');
    title('Cruise: Stabilità Longitudinale Asintotica', 'FontSize', 16);
    
    subplot(2,1,2); hold on; grid on;
    ylabel('Pitch \theta [deg]', 'FontWeight', 'bold');
    xlabel('Tempo [s]');

    for i = 1:N
        if risultati(i).converged
            t = risultati(i).t;
            vx = risultati(i).x(:,4);
            theta = rad2deg(risultati(i).x(:,8));
            
            subplot(2,1,1); plot(t, vx, 'Color', col_vx);
            subplot(2,1,2); plot(t, theta, 'Color', col_th);
        end
    end
    
    subplot(2,1,1); yline(25, '--k', 'Target', 'LineWidth', 2);
    % Zoom sulla precisione millimetrica che abbiamo trovato nel CSV
    subplot(2,1,1); ylim([20 30]); 
    subplot(2,1,2); ylim([-10 10]); 
end